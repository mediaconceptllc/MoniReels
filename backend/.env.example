# ---------------------------------------------------------------------------
# MoniReels backend. On Railway these are service variables, not a file.
#
# There is no endpoint that writes this file. The desktop build had one, and
# on a public URL an HTTP handler that rewrites its own credentials is a
# credential takeover, not a settings page.
# ---------------------------------------------------------------------------

# --- process ---------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production
# One JSON object per line, with request_id / job_id — Railway files each
# line by its "level" and lets you search by any field (@request_id:…).
# "text" gives the old plain line, for a terminal.
# LOG_FORMAT=json
# Error reports (both services). Empty = off. Get a DSN from sentry.io →
# Project → Settings → Client Keys. No request bodies, cookies or tokens are
# ever sent. Traces cost events; leave at 0 unless you want them.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# How long admin audit rows are kept.
# AUDIT_KEEP_DAYS=365
# Exact origins, comma separated. "*" stops the API from starting: with
# credentials on, it would echo back any site's origin, not refuse it.
CORS_ORIGINS=https://monireels.vercel.app,http://localhost:3000

# --- database --------------------------------------------------------------
# Railway's Postgres plugin provides this. postgres:// is normalized to
# postgresql:// automatically.
DATABASE_URL=postgresql://user:pass@localhost:5432/monireels
# Server-side limits on every app connection (not the migrations'). 0 = none.
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=15000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# How long an API instance waits for another's migration before giving up.
# MIGRATION_LOCK_WAIT_S=600
# How long the API keeps trying to reach the database at startup before it
# exits with the reason (keep it under the healthcheck timeout), and one
# connection attempt's limit.
# DB_STARTUP_WAIT_S=60
# DB_CONNECT_TIMEOUT_S=10

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Shorter than 32 bytes (or empty) and the API refuses to start.
JWT_SECRET=
JWT_HOURS=12
# Encrypts the provider keys the admin page stores in the database, so a
# database dump or backup is not a dump of the paid accounts. Set it on BOTH
# the API and the worker, to the same value. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: "new,old" — the first seals, all open; drop the old one after
# the API has started once. Lose it and the stored keys must be re-entered.
# Unset, keys are stored unencrypted (as before) and the admin page says so.
SETTINGS_ENCRYPTION_KEY=
# Used ONLY when the users table is empty, so rotating it later cannot
# silently reset an existing account.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Cloudflare R2 ---------------------------------------------------------
# Every byte of media lives here; none of it passes through the API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=monireels
# Defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PRESIGN_TTL_S=3600
R2_MPU_ABORT_H=24

# --- LLM: OpenRouter (all text work) --------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution on OpenRouter's public leaderboards. Affects nothing else.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=MoniReels

# --- STT: duudlaga.dev -----------------------------------------------------
# Keys start with dk_live_ and are sent as a bearer token.
#
# Each request is billed. Set a daily spend cap and a concurrency limit on
# the key in duudlaga's console: WORKER_LANES here bounds jobs, not
# requests, and one transcribe job sends one request per audio chunk.
#
# GET /admin/providers reports the balance, so "out of credits" can be seen
# before a job spends a worker slot discovering it.
DUUDLAGA_BASE_URL=https://api.duudlaga.dev/v1
DUUDLAGA_API_KEY=
# Optional. Omitted from the request entirely when blank — the documented
# call carries only the file, and an unexpected field risks invalid_request.
DUUDLAGA_MODEL=
DUUDLAGA_MAX_AUDIO_SEC=30
# Opus bitrate each chunk is re-encoded to before upload. OFF by default:
# duudlaga.dev answered two compressed chunks with `no_speech` that the same
# audio as WAV transcribed fine, and hung for 180s twice on a 30s one. The
# 16 kHz mono PCM it sends instead is already 6x smaller than the 48 kHz
# stereo that was failing, so the bytes were never the part still in need of
# a fix. Set a bitrate (e.g. 32k) to try compression again.
DUUDLAGA_UPLOAD_BITRATE=
# Chunks in flight at once. Nearly all of a transcription is waiting on the
# provider — 8 seconds of ffmpeg against 8 minutes of requests, measured on a
# 17:44 source — so this is the wall clock, and 4 turns ~8 minutes into ~2.
# Note it multiplies with the stt lane and the worker replicas: two
# transcribe jobs at 4 each is 8 requests at once against the same key. A 429 is retried with the
# server's own Retry-After; set 1 to serialise if the key's limit is lower.
DUUDLAGA_CONCURRENCY=4

# ---- ElevenLabs: Scribe and the Mongolian voice-over ----------------
# One key for both: Scribe hears every video not in Mongolian, and the
# voice-over reads the Mongolian translation of it (export setting, per
# project). Also settable on the admin settings page.
ELEVENLABS_API_KEY=
# The voice-over's model. The voice itself is picked on the admin page from
# the account's own list (ELEVENLABS_TTS_VOICE_ID holds the id) — there is no
# default voice, and until one is chosen a voice-over export is refused.
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_TTS_VOICE_ID=

# ---- What speech costs (the admin "Зарлага" report) -----------------
# OpenRouter states the price of every call; the speech providers do not, and
# theirs depends on your plan. Set your plan's rate here and the usage ledger
# prices each minute / character with it. Left blank, the minutes and
# characters are still recorded and the report says "тодорхойгүй" — never $0.
# A rate applies from the moment it is set; earlier rows keep their price.
# DUUDLAGA_USD_PER_MINUTE=
# ELEVENLABS_STT_USD_PER_MINUTE=
# ELEVENLABS_TTS_USD_PER_1K_CHARS=

# ---- Per-account limits (app.quotas) ---------------------------------------
# What one editor account may put on the shared queue. The lanes are
# system-wide (one render, one paid call at a time), so without these one
# account — or one stolen password — could queue dozens of exports ahead of
# everyone else, or run an unbounded provider bill. Generous defaults: normal
# work never meets them. Admins are exempt. 0 turns a limit off.
# QUOTA_ACTIVE_JOBS=10          # queued + running jobs (imports not counted)
# QUOTA_ACTIVE_PAID_JOBS=3      # of those: transcribe, suggest, translate
# QUOTA_PROJECTS_PER_HOUR=30
# QUOTA_PROJECTS_TOTAL=500
# Month-to-date KNOWN spend (USD, from the usage ledger) at which an account's
# next paid job — or voice-over export — is refused. Blank = no cap. Speech
# with no rate set above is recorded at an unknown price and cannot count
# toward it; set the rates for the cap to see speech.
# QUOTA_MONTHLY_USD=

# Escape hatches, only if the routes ever move. Defaults match the docs.
# DUUDLAGA_TRANSCRIBE_PATH=/stt/transcriptions
# DUUDLAGA_ACCOUNT_PATH=/me

# --- worker ----------------------------------------------------------------
# Jobs of each lane THIS worker runs at once. Blank = heavy=1,stt=1,llm=2:
# one render (CPU/RAM/disk of the box), one transcription (the STT
# provider), two LLM calls (suggest, translate). Counted per worker, so a
# second replica doubles every lane. A lane left out is not run here at all:
#   render pool:  WORKER_LANES=heavy=1
#   I/O pool:     WORKER_LANES=stt=2,llm=4
# A typo (hevy=1) stops the worker at startup rather than turning a lane off.
WORKER_LANES=
# Optional ceiling on the total across lanes; blank or 0 = the lanes alone.
# WORKER_CONCURRENCY=
JOB_STALE_SEC=300
JOB_KEEP_DAYS=30
WORK_DIR=/tmp/monireels
WORK_FREE_MIN_MB=2048

# --- optional ML (worker service only; needs requirements-ml.txt) ----------
# Leave OFF on any service that also answers HTTP: torch ignores the cgroup
# CPU limit, the container gets throttled, the health check times out, and
# the platform restarts the service in the middle of the job.
ENABLE_SEPARATION=false
DEMUCS_MODEL=htdemucs
# Where Demucs keeps its weights. The worker image built with INSTALL_DUB=1
# (the clean dub — a BUILD variable on the worker service, see docs/DEPLOY.md)
# sets /opt/models, where they are baked in. Empty => under WORK_DIR, which
# a restart wipes.
# MODEL_CACHE_DIR=
# 0 => derive from the container's own cgroup quota.
TORCH_THREADS=0
CPU_RESERVE=1
